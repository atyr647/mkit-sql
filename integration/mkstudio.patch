diff --git a/mkstudio.vfs/lib/app-mkstudio/loader.tcl b/mkstudio.vfs/lib/app-mkstudio/loader.tcl
index 5db1a59..0153a20 100644
--- a/mkstudio.vfs/lib/app-mkstudio/loader.tcl
+++ b/mkstudio.vfs/lib/app-mkstudio/loader.tcl
@@ -1,7 +1,14 @@
 # loader.tcl -- loads every MK Studio source file, in dependency order.
 package require Tk 8.5
 set ::mkstudio_lib [file dirname [info script]]
-foreach f {theme icons menus widgets store engine mkql grid editor explorer docs app} {
+foreach f {theme icons menus widgets store engine} {
+    source -encoding utf-8 [file join $::mkstudio_lib $f.tcl]
+}
+# the query language: mkit-sql (standard SQL).  To use the old built-in dialect instead, source
+# mkql.tcl here and drop the next two lines.
+source -encoding utf-8 [file join $::mkstudio_lib .. mkitsql mkitsql.tcl]
+source -encoding utf-8 [file join $::mkstudio_lib .. mkitsql engine_studio.tcl]
+foreach f {grid editor explorer docs app} {
     source -encoding utf-8 [file join $::mkstudio_lib $f.tcl]
 }
 package provide app-mkstudio 1.0
diff --git a/mkstudio.vfs/lib/app-mkstudio/store.tcl b/mkstudio.vfs/lib/app-mkstudio/store.tcl
index 9286540..52c90c4 100644
--- a/mkstudio.vfs/lib/app-mkstudio/store.tcl
+++ b/mkstudio.vfs/lib/app-mkstudio/store.tcl
@@ -309,6 +309,11 @@ proc ::store::createView {tag name layout} {
 
 proc ::store::dropView {tag name} {
     if {![hasView $tag $name]} { error "View '$name' does not exist in '$tag'." }
+    # `mk::view delete` leaves the rows behind: a view created again under the same name would
+    # get its old rows back.  Empty it first - and let a failure abort the drop (no catch).
+    mk::view size $tag.$name 0
+    set left [mk::view size $tag.$name]
+    if {$left != 0} { error "Cannot drop '$name': $left rows could not be cleared." }
     mk::view delete $tag.$name
     touch $tag
 }
